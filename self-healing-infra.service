[Unit]
Description=Self-Healing Infrastructure Flask Service
After=network.target

[Service]
User=seven
WorkingDirectory=/home/seven/self-healing-infra
ExecStart=/home/seven/self-healing-infra/.venv/bin/python /home/seven/self-healing-infra/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

